# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Rider / JetBrains plugin auto-generated
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE and tooling caches
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/

# Autogenerated VS/Rider/MonoDevelop files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for those
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.app
*.unitypackage

# Addressables build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS junk
.DS_Store
Thumbs.db
*.slnx

# Claude Code context file
CLAUDE.md
/docs/
